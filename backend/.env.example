# Variables d'environnement du backend LinQOrbit
# Copier ce fichier vers .env (jamais commité) ou exporter les variables dans le shell.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=linqorbit
DB_USERNAME=linqorbit
DB_PASSWORD=linqorbit

# Authentification JWT (HS256) — défauts locaux définis dans application.yml
# APP_JWT_SECRET=une-cle-secrete-d-au-moins-32-caracteres
# APP_JWT_TTL_SECONDS=86400

# Origines CORS autorisées (séparées par des virgules)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# Compte administration créé au démarrage (si aucun rôle ADMIN existant)
# ADMIN_EMAIL=admin@linqorbit.local
# ADMIN_PASSWORD=un-mot-de-passe-local-fort

# Racine disque des pièces jointes candidat (CV) — les chemins enregistrés en
# base sont relatifs : changer la racine ne perd jamais les fichiers existants.
# APP_ATTACHMENTS_ROOT=./data/attachments

# Embeddings (screening, T-64) — le modèle doit être celui appelé par le service IA
# (EMBEDDING_MODEL côté ai-service) : la réponse est vérifiée à chaque appel.
# EMBEDDING_MODEL_NAME=gemini-embedding-2
# EMBEDDING_MODEL_VERSION=1
# EMBEDDING_THREADS=1
# EMBEDDING_RETRY_DELAY_SECONDS=60
# EMBEDDING_QUOTA_RETRY_DELAY_SECONDS=300
# Pause (ms) après chaque appel au fournisseur : borne le débit (quota du palier gratuit)
# EMBEDDING_MIN_INTERVAL_MS=1000
# Backfill des fiches déjà validées au démarrage — explicite, JAMAIS par défaut
# (il appelle le fournisseur d'embeddings pour toutes les fiches courantes sans job)
# EMBEDDING_BACKFILL_ON_BOOT=false
# EMBEDDING_BACKFILL_BATCH_SIZE=100
# Taille du Top N du screening (valeur expérimentale, plafonnée à 500)
# SCREENING_TOP_N=10
# Recherche automatique de candidats à la publication d'une offre (T-101)
# SCREENING_THREADS=1
# SCREENING_RETRY_DELAY_SECONDS=30

# Image PostgreSQL requise : linqorbit-postgres:17-pgvector (postgres:17 + pgvector 0.8.7,
# D57) — la migration V28 exécute CREATE EXTENSION vector.
