# Variables d'environnement du AI-service LinQOrbit
# Copier ce fichier vers .env (jamais commité). Aucune clé réelle ici.

# Logging — console level of the service (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Client LLM — Google Gemini via langchain-google-genai (ChatGoogleGenerativeAI)
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
# Call bounds: per-request timeout (seconds) and retries passed to the SDK.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# Embeddings (screening, SPEC §8.4 / D55) — même clé GOOGLE_API_KEY.
# La dimension est une conséquence du modèle ; le backend stocke vector(1536).
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536

# LangSmith — tracing des exécutions d'agents (lu nativement par LangChain)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=linqorbit-cv-parse
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Outil de recherche web (perspective : outil futur de l'agent, hors V1)
# TAVILY_API_KEY=
